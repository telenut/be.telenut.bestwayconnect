{
  "id": "be.telenut.bestwayconnect",
  "sdk": 3,
  "name": {
    "en": "Bestway / Lay-Z Spa",
    "nl": "Bestway / Lay-Z Spa"
  },
  "description": {
    "en": "Control your Bestway Lay-Z Spa (V02/AWS models) with ease via Homey.",
    "nl": "Bedien je Bestway Lay-Z Spa (V02/AWS modellen) eenvoudig via Homey."
  },
  "version": "1.0.29",
  "compatibility": ">=10.0.0",
  "author": {
    "name": "Steven Algoet"
  },
  "support": "https://github.com/telenut/be.telenut.bestwayconnect/issues",
  "source": "https://github.com/telenut/be.telenut.bestwayconnect",
  "communityTopicId": "12345",
  "brandColor": "#005599",
  "category": [
    "appliances"
  ],
  "images": {
    "large": "/assets/images/large.png",
    "small": "/assets/images/small.png"
  },
  "platforms": [
    "local"
  ],
  "capabilities": {
    "bestway_heat": {
      "type": "boolean",
      "title": { "en": "Heating", "nl": "Verwarming" },
      "uiComponent": "button",
      "icon": "/assets/icons/heat.svg",
      "getable": true,
      "setable": true
    },
    "bestway_wave": {
      "type": "boolean",
      "title": { "en": "Bubbles", "nl": "Bubbels" },
      "uiComponent": "button",
      "icon": "/assets/icons/wave.svg",
      "getable": true,
      "setable": true
    },
    "bestway_jet": {
      "type": "boolean",
      "title": { "en": "Hydrojets", "nl": "Hydrojets" },
      "uiComponent": "button",
      "icon": "/assets/icons/jet.svg",
      "getable": true,
      "setable": true
    },
    "bestway_filter": {
      "type": "boolean",
      "title": { "en": "Filter", "nl": "Filter" },
      "uiComponent": "button",
      "icon": "/assets/icons/filter.svg",
      "getable": true,
      "setable": true
    }
  },
  "drivers": [
    {
      "id": "bestway_pump",
      "name": {
        "en": "Lay-Z Spa Pump",
        "nl": "Lay-Z Spa Pomp"
      },
      "class": "heater",
      "capabilities": [
        "onoff",
        "target_temperature",
        "measure_temperature",
        "thermostat_mode",
        "measure_power",
        "meter_power",
        "bestway_heat",
        "bestway_wave",
        "bestway_jet",
        "bestway_filter"
      ],
      "capabilitiesOptions": {
        "target_temperature": { "min": 10, "max": 40, "step": 1 },
        "measure_power": {
          "approximated": true
        },
        "meter_power": {
          "approximated": true
        },
        "thermostat_mode": {
          "values": [
            { "id": "off", "title": { "en": "Off", "nl": "Uit" } },
            { "id": "heat", "title": { "en": "Heat", "nl": "Verwarmen" } }
          ]
        }
      },
      "settings": [
        {
          "id": "wattage_heating",
          "type": "number",
          "label": { "en": "Wattage Heating", "nl": "Wattage Verwarming" },
          "hint": { "en": "E.g. 2000", "nl": "Bijv. 2000" },
          "value": 2000
        },
        {
          "id": "wattage_filter",
          "type": "number",
          "label": { "en": "Wattage Filter", "nl": "Wattage Filter" },
          "hint": { "en": "E.g. 50", "nl": "Bijv. 50" },
          "value": 50
        },
        {
          "id": "wattage_wave_half",
          "type": "number",
          "label": { "en": "Wattage Bubbles (50%)", "nl": "Wattage Bubbels (50%)" },
          "hint": { "en": "E.g. 400", "nl": "Bijv. 400" },
          "value": 400
        },
        {
          "id": "wattage_wave_full",
          "type": "number",
          "label": { "en": "Wattage Bubbles (100%)", "nl": "Wattage Bubbels (100%)" },
          "hint": { "en": "E.g. 800", "nl": "Bijv. 800" },
          "value": 800
        },
        {
          "id": "wattage_jet",
          "type": "number",
          "label": { "en": "Wattage Hydrojets", "nl": "Wattage Hydrojets" },
          "hint": { "en": "E.g. 1200", "nl": "Bijv. 1200" },
          "value": 1200
        }
      ],
      "images": {
        "large": "/drivers/bestway_pump/assets/images/large.png",
        "small": "/drivers/bestway_pump/assets/images/small.png"
      },
      "pair": [
        { "id": "manual_input" }
      ]
    }
  ],
  "flow": {
    "triggers": [
      {
        "id": "heat_changed",
        "title": { "en": "Heating turned on or off", "nl": "Verwarming ging aan of uit" },
        "titleFormatted": { "en": "Heating turned [[value]]", "nl": "Verwarming ging [[value]]" },
        "args": [
          { "name": "device", "type": "device", "filter": "driver_id=bestway_pump" },
          { "name": "value", "type": "checkbox", "label": { "en": "On", "nl": "Aan" } }
        ]
      },
      {
        "id": "wave_changed",
        "title": { "en": "Bubbles turned on or off", "nl": "Bubbels gingen aan of uit" },
        "titleFormatted": { "en": "Bubbles turned [[value]]", "nl": "Bubbels gingen [[value]]" },
        "args": [
          { "name": "device", "type": "device", "filter": "driver_id=bestway_pump" },
          { "name": "value", "type": "checkbox", "label": { "en": "On", "nl": "Aan" } }
        ]
      },
      {
        "id": "jet_changed",
        "title": { "en": "Hydrojets turned on or off", "nl": "Hydrojets gingen aan of uit" },
        "titleFormatted": { "en": "Hydrojets turned [[value]]", "nl": "Hydrojets gingen [[value]]" },
        "args": [
          { "name": "device", "type": "device", "filter": "driver_id=bestway_pump" },
          { "name": "value", "type": "checkbox", "label": { "en": "On", "nl": "Aan" } }
        ]
      },
      {
        "id": "filter_changed",
        "title": { "en": "Filter turned on or off", "nl": "Filter ging aan of uit" },
        "titleFormatted": { "en": "Filter turned [[value]]", "nl": "Filter ging [[value]]" },
        "args": [
          { "name": "device", "type": "device", "filter": "driver_id=bestway_pump" },
          { "name": "value", "type": "checkbox", "label": { "en": "On", "nl": "Aan" } }
        ]
      }
    ],
    "actions": [
      {
        "id": "set_bestway_heat",
        "title": { "en": "Turn Heating on or off", "nl": "Zet Verwarming aan of uit" },
        "titleFormatted": { "en": "Turn Heating [[value]]", "nl": "Zet Verwarming [[value]]" },
        "args": [
          { "name": "device", "type": "device", "filter": "driver_id=bestway_pump" },
          { "name": "value", "type": "checkbox", "label": { "en": "On", "nl": "Aan" } }
        ]
      },
      {
        "id": "set_bestway_wave",
        "title": { "en": "Turn Bubbles on or off", "nl": "Zet Bubbels aan of uit" },
        "titleFormatted": { "en": "Turn Bubbles [[value]]", "nl": "Zet Bubbels [[value]]" },
        "args": [
          { "name": "device", "type": "device", "filter": "driver_id=bestway_pump" },
          { "name": "value", "type": "checkbox", "label": { "en": "On", "nl": "Aan" } }
        ]
      },
      {
        "id": "set_bestway_jet",
        "title": { "en": "Turn Hydrojets on or off", "nl": "Zet Hydrojets aan of uit" },
        "titleFormatted": { "en": "Turn Hydrojets [[value]]", "nl": "Zet Hydrojets [[value]]" },
        "args": [
          { "name": "device", "type": "device", "filter": "driver_id=bestway_pump" },
          { "name": "value", "type": "checkbox", "label": { "en": "On", "nl": "Aan" } }
        ]
      },
      {
        "id": "set_bestway_filter",
        "title": { "en": "Turn Filter on or off", "nl": "Zet Filter aan of uit" },
        "titleFormatted": { "en": "Turn Filter [[value]]", "nl": "Zet Filter [[value]]" },
        "args": [
          { "name": "device", "type": "device", "filter": "driver_id=bestway_pump" },
          { "name": "value", "type": "checkbox", "label": { "en": "On", "nl": "Aan" } }
        ]
      }
    ]
  },
  "translations": {
    "en": {
      "capability": {
        "bestway_heat": { "true": "On", "false": "Off" },
        "bestway_filter": { "true": "On", "false": "Off" },
        "bestway_jet": { "true": "On", "false": "Off" }
      }
    },
    "nl": {
      "capability": {
        "bestway_heat": { "true": "Aan", "false": "Uit" },
        "bestway_filter": { "true": "Aan", "false": "Uit" },
        "bestway_jet": { "true": "Aan", "false": "Uit" }
      }
    }
  }
}