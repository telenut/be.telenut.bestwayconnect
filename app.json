{
  "id": "be.telenut.bestwayconnect",
  "sdk": 3,
  "name": {
    "en": "Bestway / Lay-Z Spa",
    "nl": "Bestway / Lay-Z Spa"
  },
  "description": {
    "en": "Control your Bestway Lay-Z Spa (V02/AWS models) with ease via Homey.",
    "nl": "Bedien je Bestway Lay-Z Spa (V02/AWS modellen) eenvoudig via Homey."
  },
  "version": "1.0.18",
  "compatibility": ">=10.0.0",
  "author": {
    "name": "Steven Algoet"
  },
  "support": "https://github.com/telenut/be.telenut.bestwayconnect/issues",
  "source": "https://github.com/telenut/be.telenut.bestwayconnect",
  "community": "https://community.homey.app/t/app-pro-bestway-lay-z-spa-connect-aws-iot/152340",
  "communityTopicId": "152340",
  "brandColor": "#005599",
  "category": [
    "appliances"
  ],
  "images": {
    "large": "/assets/images/large.png",
    "small": "/assets/images/small.png"
  },
  "platforms": [
    "local"
  ],
  "capabilities": {
    "bestway_power": {
      "type": "boolean",
      "title": {
        "en": "Power",
        "nl": "Stroom"
      },
      "uiComponent": "toggle",
      "icon": "/assets/filter.svg",
      "getable": true,
      "setable": true
    },
    "bestway_heat": {
      "type": "boolean",
      "title": {
        "en": "Heating",
        "nl": "Verwarming"
      },
      "uiComponent": "toggle",
      "icon": "/assets/heat.svg",
      "getable": true,
      "setable": true
    },
    "bestway_wave": {
      "type": "boolean",
      "title": {
        "en": "Bubbles",
        "nl": "Bubbels"
      },
      "uiComponent": "toggle",
      "icon": "/assets/wave.svg",
      "getable": true,
      "setable": true
    },
    "bestway_filter": {
      "type": "boolean",
      "title": {
        "en": "Filter",
        "nl": "Filter"
      },
      "uiComponent": "toggle",
      "icon": "/assets/filter.svg",
      "getable": true,
      "setable": true
    }
  },
  "drivers": [
    {
      "id": "bestway_pump",
      "name": {
        "en": "Lay-Z Spa Pump",
        "nl": "Lay-Z Spa Pomp"
      },
      "class": "sensor",
      "capabilities": [
        "target_temperature",
        "measure_temperature",
        "bestway_power",
        "bestway_heat",
        "bestway_wave",
        "bestway_filter"
      ],
      "capabilitiesOptions": {
        "target_temperature": {
          "min": 10,
          "max": 40,
          "step": 1
        },
        "bestway_power": {
          "uiComponent": "toggle",
          "uiStrategy": false
        },
        "bestway_heat": {
          "uiComponent": "toggle",
          "uiStrategy": false
        },
        "bestway_wave": {
          "uiComponent": "toggle",
          "uiStrategy": false
        },
        "bestway_filter": {
          "uiComponent": "toggle",
          "uiStrategy": false
        }
      },
      "images": {
        "large": "/drivers/bestway_pump/assets/images/large.png",
        "small": "/drivers/bestway_pump/assets/images/small.png"
      },
      "pair": [
        {
          "id": "manual_input"
        }
      ]
    }
  ],
  "flow": {
    "actions": [
      {
        "id": "set_bestway_power",
        "title": {
          "en": "Turn Power on or off",
          "nl": "Zet Stroom aan of uit"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=bestway_pump"
          },
          {
            "name": "value",
            "type": "checkbox",
            "label": {
              "en": "On",
              "nl": "Aan"
            }
          }
        ]
      },
      {
        "id": "set_bestway_heat",
        "title": {
          "en": "Turn Heating on or off",
          "nl": "Zet Verwarming aan of uit"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=bestway_pump"
          },
          {
            "name": "value",
            "type": "checkbox",
            "label": {
              "en": "On",
              "nl": "Aan"
            }
          }
        ]
      },
      {
        "id": "set_bestway_wave",
        "title": {
          "en": "Turn Bubbles on or off",
          "nl": "Zet Bubbels aan of uit"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=bestway_pump"
          },
          {
            "name": "value",
            "type": "checkbox",
            "label": {
              "en": "On",
              "nl": "Aan"
            }
          }
        ]
      },
      {
        "id": "set_bestway_filter",
        "title": {
          "en": "Turn Filter on or off",
          "nl": "Zet Filter aan of uit"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=bestway_pump"
          },
          {
            "name": "value",
            "type": "checkbox",
            "label": {
              "en": "On",
              "nl": "Aan"
            }
          }
        ]
      }
    ]
  }
}